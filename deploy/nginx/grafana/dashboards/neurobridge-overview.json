{
  "title": "NeuroBridge 11D - Overview",
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "type": "stat",
      "title": "API Health",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "up{job=\"neurobridge-api\"}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP Requests",
      "gridPos": { "x": 6, "y": 0, "w": 18, "h": 8 },
      "targets": [
        {
          "expr": "rate(http_requests_total[1m])"
        }
      ]
    }
  ]
}