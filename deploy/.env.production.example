ENVIRONMENT=production
PHASE=PHASE_1_PRODUCTION

HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

CTO_ACCESS_CODE=NEUROBRIDGE_SUPER_ADMIN_TOKEN
CTO_API_KEY=NEUROBRIDGE_SUPER_ADMIN_TOKEN
NEUROBRIDGE_API_KEY=NEUROBRIDGE_SUPER_ADMIN_TOKEN
API_KEY=NEUROBRIDGE_SUPER_ADMIN_TOKEN

EXTERNAL_API_ENABLED=true
EXTERNAL_API_DB_PATH=data/neurobridge_external_api.db

BENCHMARKS_ENABLED=true
BENCHMARK_REPORT_DIR=benchmarks/reports

# ============================================================================
# REDIS CONFIGURATION - CRITICAL FOR DOCKER DEPLOYMENT
# ============================================================================
# Use container name 'redis' (not localhost) for Docker internal networking
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ============================================================================
# MODBUS CONFIGURATION (Simulated mode for Phase 1)
# ============================================================================
MODBUS_SIMULATED_MODE=true
MODBUS_HOST=127.0.0.1
MODBUS_PORT=502

# ============================================================================
# PROMETHEUS METRICS
# ============================================================================
PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus_multiproc

# ============================================================================
# PHASE 1 EXCLUDED DOMAINS - Nuclear/Fusion/Quantum/Defense BLOCKED
# ============================================================================
PHASE1_EXCLUDED_DOMAINS=nuclear,fusion,quantum,defense

# ============================================================================
# CORS ALLOWED ORIGINS
# ============================================================================
CORS_ALLOW_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,http://127.0.0.1:5500

# ============================================================================
# DEMO CONFIGURATION
# ============================================================================
DEMO_ENABLED=true
DEMO_TELEMETRY_INTERVAL_SECONDS=3
DEMO_MAX_SESSION_DURATION_MINUTES=60

# ============================================================================
# WEBSOCKET CONFIGURATION
# ============================================================================
WEBSOCKET_MAX_ATTEMPTS_PER_MINUTE=10
WEBSOCKET_BLOCK_DURATION_SECONDS=300

# ============================================================================
# AECE PROTECTION MODE (MUST BE ACTIVE FOR PRODUCTION SAFETY)
# ============================================================================
AECE_PROTECTION_MODE_ACTIVE=true
AECE_FORCE_PROTECTION_MODE=true

# ============================================================================
# LOG REDACTION (Security - MUST BE ACTIVE)
# ============================================================================
LOG_REDACT_API_KEYS=true
LOG_REDACT_TOKENS=true
LOG_REDACT_PII=true

# ============================================================================
# CIRCUIT BREAKER DEFAULTS
# ============================================================================
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=60
CIRCUIT_BREAKER_SUCCESS_THRESHOLD=2

# ============================================================================
# CACHE CONFIGURATION
# ============================================================================
ENABLE_REDIS_CACHE=true
CACHE_TTL_SECONDS=300

# ============================================================================
# ANALYTICS
# ============================================================================
ENABLE_ANALYTICS=true